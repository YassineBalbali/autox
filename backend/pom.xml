<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.autox</groupId>
    <artifactId>autox-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>autox-backend</name>
    <description>AutoX marketplace API</description>

    <properties>
        <java.version>21</java.version>
        <awssdk.version>2.57.6</awssdk.version>
        <springdoc.version>2.10.0</springdoc.version>
        <therapi.version>0.16.0</therapi.version>

        <!-- Security overrides of versions the Spring Boot parent manages. Each one is here
             because the dependency scan in CI reported a HIGH or CRITICAL advisory fixed in
             a patch release newer than the one Boot 3.5.16 ships, and 3.5.16 is the latest
             3.5.x. They are patch-level bumps within the same minor line.

             Delete an entry when a newer Boot parent manages a version at least as new:
             an override that has fallen behind its parent holds a dependency back. -->
        <tomcat.version>10.1.61</tomcat.version>
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <postgresql.version>42.7.14</postgresql.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Not managed by the Spring Boot BOM, so the version is pinned here. -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${awssdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Provides the Nimbus JWT encoder/decoder and the bearer-token filter,
             so no third-party JWT library is needed. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- S3 API client. MinIO, Cloudflare R2, Backblaze B2, Scaleway and AWS itself
             all speak this protocol, so the provider is a matter of configuration. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <exclusions>
                <!-- The S3 module pulls in two HTTP clients this application never uses:
                     the Netty one (for the async client; ours is synchronous) and the
                     Apache 5 one. StorageConfig builds the client on Apache 4 explicitly.
                     Unused code is not harmless when it is on the classpath: Netty and
                     HttpCore 5 accounted for eight of the advisories the scan reported. -->
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache5-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Apache HTTP client: the default URL-connection client cannot stream a PUT
             without buffering it, which matters for variant uploads. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>apache-client</artifactId>
        </dependency>

        <!-- OpenAPI, generated from the controllers and bean-validation annotations rather
             than hand-written, so the spec cannot drift from the code it describes. Serves
             /v3/api-docs and a Swagger UI at /swagger-ui.html. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <!-- Makes the Javadoc already on the controllers and DTOs readable at runtime, so
             springdoc uses it for summaries and schema descriptions. The alternative is a
             second copy of every explanation inside @Operation and @Schema annotations,
             which is exactly the kind of duplication that goes stale. -->
        <dependency>
            <groupId>com.github.therapi</groupId>
            <artifactId>therapi-runtime-javadoc</artifactId>
            <version>${therapi.version}</version>
        </dependency>

        <!-- Health endpoint only: something has to be able to tell a load balancer whether
             an instance is serving. Everything else actuator offers is switched off in
             configuration rather than left exposed. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Real object storage in tests: the upload flow is only meaningful against
             something that actually honours pre-signed URLs. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>minio</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Records the Javadoc into the class files for therapi to read back. Without
                 this processor the dependency above is inert and the spec loses its prose. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.github.therapi</groupId>
                            <artifactId>therapi-runtime-javadoc-scribe</artifactId>
                            <version>${therapi.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
