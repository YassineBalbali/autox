{
  "about": "Natural-language search evaluation set. Each query has the filters a careful human would apply, in the URL's terms: make and model as catalogue slugs, prices in whole euros, enums as API names. Relative years are written now-N and resolved against the year the eval runs. 'unsupported' lists words that must appear in what the API reports as not understood; null means the query is not scored on it. The catalogue these slugs name is the local development one, listed in docs/ai-search.md.",
  "queries": [
    { "id": "brief", "query": "SUV diesel automatique moins de 15 000 € en bon état",
      "expected": { "body": ["SUV"], "fuel": ["DIESEL"], "gearbox": ["AUTOMATIC"], "priceMax": 15000 },
      "unsupported": ["bon état"], "tags": ["body", "fuel", "gearbox", "price", "unsupported"] },
    { "id": "make-model-fuel", "query": "Renault Clio essence",
      "expected": { "make": "renault", "model": "clio", "fuel": ["PETROL"] },
      "unsupported": [], "tags": ["make", "model", "fuel"] },
    { "id": "plugin", "query": "peugeot 3008 hybride rechargeable",
      "expected": { "make": "peugeot", "model": "3008", "fuel": ["PLUGIN_HYBRID"] },
      "unsupported": [], "tags": ["make", "model", "fuel"] },
    { "id": "model-alone-year", "query": "golf diesel 2018",
      "expected": { "make": "volkswagen", "model": "golf", "fuel": ["DIESEL"], "yearFrom": 2018, "yearTo": 2018 },
      "unsupported": [], "tags": ["model", "fuel", "year"] },
    { "id": "price-euros-word", "query": "Tesla Model 3 moins de 30000 euros",
      "expected": { "make": "tesla", "model": "model-3", "priceMax": 30000 },
      "unsupported": [], "tags": ["make", "model", "price"] },
