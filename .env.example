# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env     # then fill in the two blanks below
#   docker compose up -d
#   cd backend && mvn spring-boot:run
#
# This one file configures a local machine. Both readers use it:
#   - docker compose, natively
#   - the application, through DotenvEnvironmentPostProcessor at startup
# so there is nothing to export by hand. A real environment variable overrides anything
# here, which is how CI and production stay unaffected by this file.
#
# Syntax notes, because the two readers are not identical:
#   - Whole-line "#" comments only. A "#" inside a value is part of the value, since a
#     password containing one is indistinguishable from a trailing comment.
#   - No variable interpolation. docker compose expands "${OTHER}"; the application does
#     not, so write values out in full.
#   - AVOID "${" INSIDE A PASSWORD. Spring resolves placeholders inside every property
#     value, so a password of p${ass}word is unusable — it will be reported as not set.
#     Any other punctuation is fine.

# ---- docker-compose postgres ----
# Port 5433, not 5432: if a PostgreSQL is already installed on the machine it owns
# 5432, and the connection silently goes to that server instead of this container.
POSTGRES_DB=autox
POSTGRES_USER=autox
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5433

# ---- backend datasource (must match the values above) ----
AUTOX_DB_URL=jdbc:postgresql://localhost:5433/autox
AUTOX_DB_USERNAME=autox
AUTOX_DB_PASSWORD=change-me-locally

# ---- JWT signing ----
# HS256 key, minimum 32 bytes. Generate one with:
#   openssl rand -base64 48
# A different value per environment. Rotating it invalidates every access token
# in flight (refresh tokens are unaffected — they are random, not signed).
AUTOX_JWT_SECRET=
AUTOX_JWT_ISSUER=https://api.autox.local

# ---- transactional email ----
# `log` writes the message to the application log instead of sending it. That is what
# makes the password reset flow walkable locally: the link appears in the console.
# It is ALSO a credential leak — anyone who can read the log can take over any account —
# so production needs a real provider and an EmailSender bean conditional on this value.
AUTOX_MAIL_PROVIDER=log
AUTOX_MAIL_FROM=no-reply@autox.local
AUTOX_MAIL_FROM_NAME=AutoX

# The frontend page that accepts a reset token. The email links to it with ?token=…
# The API cannot guess it: the web app is deployed separately.
AUTOX_PASSWORD_RESET_URL=http://localhost:4200/reinitialiser-mot-de-passe

# ---- object storage (MinIO locally, any S3-compatible provider in production) ----
MINIO_ROOT_USER=autox
MINIO_ROOT_PASSWORD=change-me-locally
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Must match the MinIO values above. In production these become the provider's
# endpoint and keys — Cloudflare R2, Scaleway, AWS S3; the code does not change.
AUTOX_S3_ENDPOINT=http://localhost:9000
AUTOX_S3_REGION=us-east-1
AUTOX_S3_BUCKET=autox-images
AUTOX_S3_ACCESS_KEY=autox
AUTOX_S3_SECRET_KEY=change-me-locally
# MinIO and any IP-addressed endpoint need path-style addressing.
AUTOX_S3_PATH_STYLE=true
# Local dev only: creates the bucket on startup if it is missing.
AUTOX_S3_CREATE_BUCKET=true
# Set to a CDN or public-bucket origin in production. Empty = hand out signed,
# expiring read URLs instead.
AUTOX_S3_PUBLIC_BASE_URL=

# ---- demo data ----
# Uncomment to fill an empty database with 60 invented listings, eight accounts and a
# ten-make catalogue, so the search screen has something to show — sixty because a page
# of results is 24, and "voir plus" needs more than two pages to be worth trying. Seeds once; restarting
# with it still set does nothing. Everything it creates is recorded in a ledger table
# (demo_seed_ledger), and removal deletes exactly those rows and their stored photos.
#
#   SPRING_PROFILES_ACTIVE=demo                            seed
#   SPRING_PROFILES_ACTIVE=demo + AUTOX_DEMO_ACTION=remove remove, then unset both
#
# Never against a database with real users: it writes invented accounts and listings. The
# public demo is seeded this way once, then the profile is switched off again — see
# docs/deployment.md, step 4. Without the profile the demo code is not loaded at all.
#SPRING_PROFILES_ACTIVE=demo
#AUTOX_DEMO_ACTION=seed
# A folder of real JPEGs named make-model.jpg (peugeot-308.jpg) to use instead of the
# drawn placeholders. Optional.
#AUTOX_DEMO_PHOTO_DIR=

# ---- optional ----
AUTOX_PORT=8081
AUTOX_LOG_LEVEL=DEBUG

# Browser origins allowed to call the API. Comma-separated. A native app is not
# subject to CORS, so this is only about the Angular dev server and the web origin.
AUTOX_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Per-IP limit on the unauthenticated GETs, per minute. 300 is five a second, well
# clear of a real visitor. Lower it to see the limiter work; leave it enabled.
AUTOX_PUBLIC_RATE_LIMIT_ENABLED=true
AUTOX_PUBLIC_RATE_LIMIT_REQUESTS=300
