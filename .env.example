# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env
#   docker compose up -d
#   cd backend && mvn spring-boot:run

# ---- docker-compose postgres ----
# Port 5433, not 5432: if a PostgreSQL is already installed on the machine it owns
# 5432, and the connection silently goes to that server instead of this container.
POSTGRES_DB=autox
POSTGRES_USER=autox
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5433

# ---- backend datasource (must match the values above) ----
AUTOX_DB_URL=jdbc:postgresql://localhost:5433/autox
AUTOX_DB_USERNAME=autox
AUTOX_DB_PASSWORD=change-me-locally

# ---- JWT signing ----
# HS256 key, minimum 32 bytes. Generate one with:
#   openssl rand -base64 48
# A different value per environment. Rotating it invalidates every access token
# in flight (refresh tokens are unaffected — they are random, not signed).
AUTOX_JWT_SECRET=
AUTOX_JWT_ISSUER=https://api.autox.local

# ---- optional ----
AUTOX_PORT=8080
AUTOX_LOG_LEVEL=DEBUG
