<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: nothing is backed up to the cloud or copied to a new device. The
     refresh token in secure storage is tied to this device's keystore; restored elsewhere it
     would be unreadable at best, a second copy of a live credential at worst. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
